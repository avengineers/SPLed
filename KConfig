mainmenu "SPLed"

source ".venv/Lib/site-packages/spl_core/config/KConfig"

menu "Features"
    config BLINKING
        bool "Blinking Feature"
        default n
    
    if BLINKING
        choice BLINKING_RATE
            prompt "Select Blinking Mode"
            default BLINKING_RATE_FIXED
            config BLINKING_RATE_FIXED
                bool "Fixed"

            config BLINKING_RATE_MANUALLY_ADJUSTABLE
                bool "Manually adjustable"

            config BLINKING_RATE_AUTO_ADJUSTABLE
                bool "Automatically adjustable"
        endchoice
    endif

    config BRIGHTNESS_ADJUSTMENT
        bool "Brightness Adjustment Feature"
        depends on !BLINKING
        default n

    config BRIGHTNESS_ADJUSTMENT_PERIOD
        int "Brightness Adjustment Period (in seconds)"
        depends on BRIGHTNESS_ADJUSTMENT
        default 5
        range 1 60
        help
            This option allows you to set the period for brightness adjustment.
            The value is in seconds and can be set between 1 and 60 seconds.

    source "src/os/KConfig"
    source "src/light_controller/KConfig"

endmenu
