        "REQ_36": {
          "id": "REQ_36",
          "title": "Power Button Input Processing",
          "content": ".. raw:: html\n\n   <div style='white-space: pre-wrap;'><div>The system shall provide a debounced power button input to prevent spurious signals. A key press shall only be registered after its state is consistently detected for a configurable debounce period.</div></div>",
          "reqif_uuid": "_36_a8228a3b-b6e8-4eb0-b0e0-e20e35553a0d",
          "sections": [
            "Power Management",
            "Functional Requirements",
            "Specific Requirements"
          ],
          "section_name": "Power Management",
          "origin": "External",
          "type": "spec",
          "priority": "high"
        },
        "REQ_38": {
          "id": "REQ_38",
          "title": "Power State Control",
          "content": ".. raw:: html\n\n   <div style='white-space: pre-wrap;'><div>The system shall toggle the power state between ON and OFF when the power button is pressed.</div></div>",
          "reqif_uuid": "_38_ddd93c7f-fac8-4079-a140-e0eb2a8dec6c",
          "sections": [
            "Power Management",
            "Functional Requirements",
            "Specific Requirements"
          ],
          "section_name": "Power Management",
          "origin": "External",
          "type": "spec",
          "priority": "high"
        },
        "REQ_39": {
          "id": "REQ_39",
          "configuration": "AUTO_OFF",
          "title": "Automatic Power Off",
          "content": ".. raw:: html\n\n   <div style='white-space: pre-wrap;'><div>The system shall automatically turn off after a configurable period of user inactivity. The timeout period shall be configurable between 5 and 7200 seconds.</div></div>",
          "reqif_uuid": "_39_ddfd62bb-664b-4a27-bac8-cac642230146",
          "sections": [
            "Power Management",
            "Functional Requirements",
            "Specific Requirements"
          ],
          "section_name": "Power Management",
          "origin": "External",
          "type": "spec",
          "priority": "high"
        },
        "REQ_40": {
          "id": "REQ_40",
          "title": "Inactivity Detection",
          "content": ".. raw:: html\n\n   <div style='white-space: pre-wrap;'><div>The system shall detect user activity from the following inputs and reset the auto-off timer accordingly:<br/>- Power button presses<br/>- Up control key presses<br/>- Down control key presses</div></div>",
          "reqif_uuid": "_40_0d214405-bc18-4155-9ffc-130fc1eeddee",
          "sections": [
            "Power Management",
            "Functional Requirements",
            "Specific Requirements"
          ],
          "section_name": "Power Management",
          "origin": "External",
          "type": "spec",
          "priority": "high"
        },
        "REQ_42": {
          "id": "REQ_42",
          "title": "Light State Management",
          "content": ".. raw:: html\n\n   <div style='white-space: pre-wrap;'><div>The light shall be in one of two states: ON or OFF. The light state shall follow the system&#x27;s power state.</div></div>",
          "reqif_uuid": "_42_8623f81b-9fc1-45d9-bdc1-577a01596d9e",
          "sections": [
            "Light Control",
            "Functional Requirements",
            "Specific Requirements"
          ],
          "section_name": "Light Control",
          "origin": "External",
          "type": "spec",
          "priority": "high"
        },
        "REQ_43": {
          "id": "REQ_43",
          "title": "Light Color Configuration",
          "content": ".. raw:: html\n\n   <div style='white-space: pre-wrap;'><div>The light color shall be specified as an RGB value. The color shall be fixed but configurable at build time.</div></div>",
          "reqif_uuid": "_43_c7194451-44c5-4587-a1b9-94c128cdaaa0",
          "sections": [
            "Light Control",
            "Functional Requirements",
            "Specific Requirements"
          ],
          "section_name": "Light Control",
          "origin": "External",
          "type": "spec",
          "priority": "high"
        },
        "REQ_44": {
          "id": "REQ_44",
          "configuration": "BLINKING",
          "title": "Blinking Behavior",
          "content": ".. raw:: html\n\n   <div style='white-space: pre-wrap;'><div>When the light is ON, it may exhibit a blinking behavior. The blinking rate shall be determined based on the main knob value.</div></div>",
          "reqif_uuid": "_44_45e57d01-bbe7-4506-9c91-4bb6229bac75",
          "sections": [
            "Light Control",
            "Functional Requirements",
            "Specific Requirements"
          ],
          "section_name": "Light Control",
          "origin": "External",
          "type": "spec",
          "priority": "high"
        },
        "REQ_46": {
          "id": "REQ_46",
          "title": "Brightness Value Range",
          "content": ".. raw:: html\n\n   <div style='white-space: pre-wrap;'><div>The brightness of the light shall be represented by an integer value from 0 to 255.</div></div>",
          "reqif_uuid": "_46_0464a7c0-d7da-47aa-a2ad-4b91bec820b1",
          "sections": [
            "Brightness Control",
            "Functional Requirements",
            "Specific Requirements"
          ],
          "section_name": "Brightness Control",
          "origin": "External",
          "type": "spec",
          "priority": "high"
        },
        "REQ_47": {
          "id": "REQ_47",
          "configuration": "BRIGHTNESS_ADJUSTMENT_MANUAL",
          "title": "Manual Brightness Adjustment",
          "content": ".. raw:: html\n\n   <div style='white-space: pre-wrap;'><div>The brightness of the light shall be adjustable by the user via the main control knob (percentage input).</div></div>",
          "reqif_uuid": "_47_f69d54b7-c756-4fba-8f0c-e26f9c4df07c",
          "sections": [
            "Brightness Control",
            "Functional Requirements",
            "Specific Requirements"
          ],
          "section_name": "Brightness Control",
          "origin": "External",
          "type": "spec",
          "priority": "high"
        },
        "REQ_48": {
          "id": "REQ_48",
          "configuration": "BRIGHTNESS_ADJUSTMENT_AUTOMATIC",
          "title": "Automatic Brightness Adjustment",
          "content": ".. raw:: html\n\n   <div style='white-space: pre-wrap;'><div>The brightness of the light shall be automatically adjusted based on a configurable period.</div></div>",
          "reqif_uuid": "_48_5706e0db-b1fb-43a5-9d0f-0d88909628ea",
          "sections": [
            "Brightness Control",
            "Functional Requirements",
            "Specific Requirements"
          ],
          "section_name": "Brightness Control",
          "origin": "External",
          "type": "spec",
          "priority": "high"
        },
        "REQ_50": {
          "id": "REQ_50",
          "title": "Main Control Knob",
          "content": ".. raw:: html\n\n   <div style='white-space: pre-wrap;'><div>The system shall provide a main control knob that allows the user to adjust a percentage value (0-100%) using Arrow Up and Arrow Down keys.</div></div>",
          "reqif_uuid": "_50_db2a156c-13da-45bf-8571-418abc633699",
          "sections": [
            "User Input",
            "Functional Requirements",
            "Specific Requirements"
          ],
          "section_name": "User Input",
          "origin": "External",
          "type": "spec",
          "priority": "high"
        },
        "REQ_51": {
          "id": "REQ_51",
          "title": "Knob Value Persistence",
          "content": ".. raw:: html\n\n   <div style='white-space: pre-wrap;'><div>The main control knob value shall be stored and retrievable through the RTE interfaces.</div></div>",
          "reqif_uuid": "_51_e5a3b4f5-61be-4d45-9b52-51d0953704ac",
          "sections": [
            "User Input",
            "Functional Requirements",
            "Specific Requirements"
          ],
          "section_name": "User Input",
          "origin": "External",
          "type": "spec",
          "priority": "high"
        },
        "REQ_53": {
          "id": "REQ_53",
          "title": "Power State Interface",
          "content": ".. raw:: html\n\n   <div style='white-space: pre-wrap;'><div>The system shall provide an RTE interface `RteGetPowerState()` to retrieve the current power state.</div></div>",
          "reqif_uuid": "_53_213a4363-e949-49ac-8037-2a9f5e4104f6",
