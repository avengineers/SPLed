# Enforce consistent line endings across all forks/platforms.
# All text files are stored with LF in the repository and checked out with LF.
* text=auto eol=lf

# Windows batch scripts must keep CRLF to run reliably under cmd.exe.
*.bat text eol=crlf

# Binary files must never be modified by line-ending normalization.
*.png binary
*.pdf binary
*.reqifz binary
